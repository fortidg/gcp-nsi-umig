# Example Terraform variables file for FortiGate NSI deployment
# Copy this file to terraform.tfvars and customize the values

# Required Variables
project_id      = "your-gcp-project-id"
organization_id = "your-gcp-organization-id"
region          = "us-central1"
prefix          = "fgt-nsi"

# FortiGate Configuration
fortigate_license_type    = "payg"  # Options: "payg" or "byol"
fortigate_machine_type    = "c4-standard-4"
fortigate_instance_count  = 3

# Zones for FortiGate distribution (must be in the specified region)
zones = [
  "us-central1-a",
  "us-central1-b",
  "us-central1-c"
]

# Admin Configuration
admin_port     = 8443
admin_password = "YourSecurePasswordHere!"

# Demo workload (optional)
# Set to false to deploy only the FortiGate NSI side, without the web/web2 VPCs,
# VPC peering and web server VMs. You then associate your own VPCs with NSI.
# deploy_web_servers = true

# Network Configuration (optional customization)
# inspection_subnet_cidr  = "10.50.160.0/24"
# management_subnet_cidr  = "10.50.180.0/24"
# web_subnet_cidr        = "10.12.0.0/24"

# Load Balancer Configuration (optional)
# health_check_port = 8080
# geneve_port      = 6081

# Optional Settings
# enable_private_google_access = true

# Additional tags (optional)
# tags = {
#   environment = "production"
#   team       = "networking"
# }

# Additional instance configs (optional)
# flx_tok is a top-level attribute of instance_configs, NOT a custom_metadata key.
# Nesting it under custom_metadata just adds an unused GCE metadata key and leaves
# the license section out of the rendered cloud-init.
# custom_metadata is only for extra GCE metadata keys; if you add any, be sure to
# update fortigate-config.tpl in the templates folder to consume them.
instance_configs = {
  "us-central1-a" = {
    flx_tok = "<your token here>"
  }
  "us-central1-b" = {
    flx_tok = "<your token here>"
  }
  "us-central1-c" = {
    flx_tok = "<your token here>"
  }
}