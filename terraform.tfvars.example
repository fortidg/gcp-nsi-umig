# Example Terraform variables file for FortiGate NSI deployment
# Copy this file to terraform.tfvars and customize the values

# Required Variables
project_id      = "your-gcp-project-id"
# Required only when nsi_security_profile_scope = "organization".
# organization_id = "your-gcp-organization-id"
region          = "us-central1"
prefix          = "fgt-nsi"

# FortiGate Configuration
fortigate_license_type    = "payg"  # Options: "payg" or "byol"
fortigate_version         = "76"    # Image family fortigate-<version>-<license_type>, e.g. "76" or "80"

# Optional: pin a specific image instead of the latest in the family.
# Overrides fortigate_version and fortigate_license_type.
# 7.6.8 BYOL is projects/fortigcp-project-001/global/images/fortinet-fgt-768-20261016-001-w-license
# fortigate_vm_image      = "projects/fortigcp-project-001/global/images/fortinet-fgt-748-20250529-001-w-license"
fortigate_machine_type    = "c4-standard-4"
fortigate_instance_count  = 3

# Zones for FortiGate distribution (must be in the specified region)
zones = [
  "us-central1-a",
  "us-central1-b",
  "us-central1-c"
]

# Admin Configuration
admin_port     = 8443
admin_password = "YourSecurePasswordHere!"

# Demo workload (optional)
# Set to false to deploy only the FortiGate NSI side, without the web/web2 VPCs,
# NCC demo spokes and web server VMs. Set nsi_consumer_vpc_names to inspect
# existing workload VPCs.
# deploy_web_servers = true
# To connect existing VPCs through the same full mesh NCC hub:
# ncc_existing_vpc_names = ["two-gke-a-vpc", "two-gke-b-vpc"]
# To attach the NSI endpoint group and firewall policy to existing VPCs:
# nsi_consumer_vpc_names = ["two-gke-a-vpc", "two-gke-b-vpc"]
# Optional: prefix for security profile names. The default is project_id.
# nsi_name_prefix = "my-project"
# Profiles and groups default to project scope. Organization scope requires
# roles/networksecurity.securityProfileAdmin on the organization.
# nsi_security_profile_scope = "organization"

# Network Configuration (optional customization)
# inspection_subnet_cidr  = "10.50.160.0/24"
# management_subnet_cidr  = "10.50.180.0/24"
# web_subnet_cidr        = "10.12.0.0/24"

# Load Balancer Configuration (optional)
# health_check_port = 8080
# geneve_port      = 6081

# Optional Settings
# enable_private_google_access = true

# Additional tags (optional)
# tags = {
#   environment = "production"
#   team       = "networking"
# }

# Additional instance configs (optional)
# flx_tok is a top-level attribute of instance_configs, NOT a custom_metadata key.
# Nesting it under custom_metadata just adds an unused GCE metadata key and leaves
# the license section out of the rendered cloud-init.
# custom_metadata is only for extra GCE metadata keys; if you add any, be sure to
# update fortigate-config.tpl in the templates folder to consume them.
instance_configs = {
  "us-central1-a" = {
    flx_tok = "<your token here>"
  }
  "us-central1-b" = {
    flx_tok = "<your token here>"
  }
  "us-central1-c" = {
    flx_tok = "<your token here>"
  }
}
